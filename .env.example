ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

PROJECT_NAME="BARIYON Receptra"
PROJECT_VERSION="1.0.0"

OPENAI_API_KEY=sk-your-api-key-here
# gpt-4o系は2026年に段階的に廃止されたため、現行モデルを既定値にしている
OPENAI_MODEL=gpt-5.6-luna
# 電話AI受付専用のモデル/上限（未設定ならOPENAI_MODELを使用）
VOICE_AI_MODEL=
VOICE_AI_MAX_TOKENS=300
VOICE_AI_MAX_TURNS=8

PAYJP_API_KEY=sk_test_your_key_here
PAYJP_SECRET_KEY=sk_test_your_secret_here

SECRET_KEY=dev-secret-key-12345678

# ===== Database Configuration =====
DATABASE_URL=postgresql+asyncpg://user:password@railway_host/receptra
DATABASE_ECHO=False
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ===== Redis Configuration =====
REDIS_URL=redis://railway_redis_host:6379/0

# ===== Frontend Configuration =====
